from __future__ import annotations

import json
import re
import unicodedata
from dataclasses import dataclass
from difflib import SequenceMatcher
from pathlib import Path
from typing import Iterable

from PySide6.QtGui import QPixmap


@dataclass(slots=True)
class LogoMatch:
    manufacturer: str
    path: Path | None
    matched_text: str = ""


class DeltaLogoManager:
    """
    Localiza logos usando múltiplos textos do LMU.

    Compatível com:
    - mVehicleName
    - mVehFilename
    - mPitGroup
    - mVehicleModel
    """

    DEFAULT_ALIASES: dict[str, list[str]] = {
        "alpine": ["alpine", "a424"],
        "aston_martin": [
            "aston martin",
            "astonmartin",
            "amr",
            "vantage",
            "valkyrie",
        ],
        "bmw": ["bmw", "m hybrid", "m4 gt3", "m8 gte"],
        "cadillac": ["cadillac", "v-series", "v series"],
        "chevrolet": ["chevrolet", "corvette", "z06 gt3"],
        "duqueine": ["duqueine", "d08", "d09"],
        "ferrari": ["ferrari", "499p", "296 gt3", "488 gte"],
        "ford": ["ford", "mustang gt3"],
        "genesis": ["genesis", "gmr-001", "gmr 001"],
        "ginetta": ["ginetta"],
        "glickenhaus": ["glickenhaus", "scg", "007 lmh", "007lmh"],
        "honda": ["honda", "acura", "nsx"],
        "isotta_fraschini": [
            "isotta fraschini",
            "isotta",
            "tipo 6",
            "tipo6",
        ],
        "lamborghini": ["lamborghini", "sc63", "huracan"],
        "lexus": ["lexus", "rc f gt3", "rcf gt3"],
        "ligier": ["ligier", "js p", "jsp"],
        "mclaren": ["mclaren", "720s"],
        "mercedes": [
            "mercedes",
            "mercedes benz",
            "mercedes-amg",
            "amg gt3",
        ],
        "oreca": ["oreca", "07 gibson", "oreca 07"],
        "peugeot": ["peugeot", "9x8"],
        "porsche": [
            "porsche",
            "porshce",
            "963",
            "911 gt3",
            "911 rsr",
        ],
        "toyota": ["toyota", "gr010"],
        "vanwall": ["vanwall", "vandervell"],
        "dallara": ["dallara"],
    }

    FILE_ALIASES: dict[str, list[str]] = {
        "aston_martin": ["aston martin", "astonmartin", "amr"],
        "chevrolet": ["chevrolet", "corvette"],
        "isotta_fraschini": [
            "isotta fraschini",
            "isotta_fraschini",
            "isotta",
        ],
        "mclaren": ["mclaren", "mc laren"],
        "mercedes": ["mercedes", "mercedes benz", "mercedes_benz"],
        "porsche": ["porsche", "porshce"],
    }

    def __init__(
        self,
        project_root: Path,
        configured_directory: str | None = None,
    ) -> None:
        self.project_root = Path(project_root)
        self.logo_directory = self._resolve_directory(configured_directory)
        self.aliases = self._load_aliases()
        self._path_index = self._index_files()
        self._pixmap_cache: dict[Path, QPixmap] = {}
        self._directory_stamp = self._directory_signature()

    def set_directory(self, configured_directory: str | None) -> None:
        resolved = self._resolve_directory(configured_directory)

        if resolved != self.logo_directory:
            self.logo_directory = resolved

        self.refresh()

    def refresh(self) -> None:
        self.aliases = self._load_aliases()
        self._path_index = self._index_files()
        self._pixmap_cache.clear()
        self._directory_stamp = self._directory_signature()

    def match(self, *vehicle_texts: str) -> LogoMatch:
        """
        Aceita um ou vários textos.

        Exemplo:
            match(vehicle_name, vehicle_filename, pit_group, player_model)
        """
        self._refresh_if_changed()

        normalized_values = [
            self._normalize(value)
            for value in vehicle_texts
            if str(value or "").strip()
        ]
        combined = " ".join(normalized_values).strip()

        if not combined:
            return LogoMatch(
                manufacturer="Car",
                path=self._path_for_manufacturer("default"),
            )

        for manufacturer, aliases in self.aliases.items():
            for alias in aliases:
                normalized_alias = self._normalize(alias)

                if normalized_alias and normalized_alias in combined:
                    path = self._path_for_manufacturer(manufacturer)

                    if path is None:
                        self.refresh()
                        path = self._path_for_manufacturer(manufacturer)

                    return LogoMatch(
                        manufacturer=self._display_name(manufacturer),
                        path=path,
                        matched_text=alias,
                    )

        direct = self._direct_file_match(normalized_values)

        if direct is not None:
            manufacturer, path = direct
            return LogoMatch(
                manufacturer=self._display_name(manufacturer),
                path=path,
                matched_text=manufacturer,
            )

        return LogoMatch(
            manufacturer="Car",
            path=self._path_for_manufacturer("default"),
            matched_text=combined,
        )

    def pixmap(self, path: Path | None) -> QPixmap | None:
        if path is None or not path.exists():
            return None

        cached = self._pixmap_cache.get(path)

        if cached is not None:
            return cached

        pixmap = QPixmap(str(path))

        if pixmap.isNull():
            return None

        self._pixmap_cache[path] = pixmap
        return pixmap

    def diagnostics(self) -> dict[str, object]:
        return {
            "project_root": str(self.project_root),
            "logo_directory": str(self.logo_directory),
            "logo_directory_exists": self.logo_directory.exists(),
            "indexed_keys": sorted(self._path_index.keys()),
            "indexed_files": sorted(
                str(path.name)
                for path in set(self._path_index.values())
            ),
        }

    def _resolve_directory(self, configured_directory: str | None) -> Path:
        candidates: list[Path] = []

        if configured_directory:
            configured = Path(str(configured_directory).strip())
            candidates.append(
                configured
                if configured.is_absolute()
                else self.project_root / configured
            )

        candidates.extend(
            [
                self.project_root / "images" / "logos",
                self.project_root / "images" / "logo",
                self.project_root / "src" / "images" / "logos",
                self.project_root / "images",
            ]
        )

        for candidate in candidates:
            if candidate.exists() and candidate.is_dir():
                return candidate.resolve()

        fallback = self.project_root / "images" / "logos"
        fallback.mkdir(parents=True, exist_ok=True)
        return fallback.resolve()

    def _load_aliases(self) -> dict[str, list[str]]:
        aliases = {
            key: list(values)
            for key, values in self.DEFAULT_ALIASES.items()
        }
        aliases_file = self.logo_directory / "manufacturer_aliases.json"

        if aliases_file.exists():
            try:
                custom = json.loads(
                    aliases_file.read_text(encoding="utf-8")
                )

                for key, values in custom.items():
                    if not isinstance(values, list):
                        continue

                    canonical = self._canonical_key(str(key))
                    current = aliases.setdefault(canonical, [])

                    for value in values:
                        text = str(value)

                        if text not in current:
                            current.append(text)

            except (OSError, json.JSONDecodeError):
                pass

        return aliases

    def _index_files(self) -> dict[str, Path]:
        result: dict[str, Path] = {}
        allowed = {".png", ".jpg", ".jpeg", ".webp"}

        if not self.logo_directory.exists():
            return result

        for path in self.logo_directory.iterdir():
            if not path.is_file() or path.suffix.lower() not in allowed:
                continue

            normalized = self._normalize(path.stem)
            canonical = self._canonical_key(path.stem)
            compact = self._compact(normalized)

            for key in {normalized, canonical, compact}:
                if key:
                    result.setdefault(key, path)

        return result

    def _path_for_manufacturer(self, manufacturer: str) -> Path | None:
        candidates = [
            manufacturer,
            manufacturer.replace("_", " "),
            manufacturer.replace("_", ""),
        ]
        candidates.extend(self.FILE_ALIASES.get(manufacturer, []))

        for candidate in candidates:
            normalized = self._normalize(candidate)
            keys = {
                normalized,
                self._canonical_key(candidate),
                self._compact(normalized),
            }

            for key in keys:
                path = self._path_index.get(key)

                if path is not None:
                    return path

        target = self._compact(
            self._normalize(manufacturer.replace("_", " "))
        )
        best_ratio = 0.0
        best_path: Path | None = None

        for key, path in self._path_index.items():
            ratio = SequenceMatcher(
                None,
                target,
                self._compact(key),
            ).ratio()

            if ratio > best_ratio:
                best_ratio = ratio
                best_path = path

        return best_path if best_ratio >= 0.74 else None

    def _direct_file_match(
        self,
        normalized_values: Iterable[str],
    ) -> tuple[str, Path] | None:
        combined = " ".join(normalized_values)
        combined_compact = self._compact(combined)

        for key, path in self._path_index.items():
            compact_key = self._compact(key)

            if compact_key and compact_key in combined_compact:
                return key, path

        return None

    def _refresh_if_changed(self) -> None:
        current = self._directory_signature()

        if current != self._directory_stamp:
            self.refresh()

    def _directory_signature(self) -> tuple[tuple[str, int, int], ...]:
        if not self.logo_directory.exists():
            return ()

        signature: list[tuple[str, int, int]] = []

        try:
            for path in self.logo_directory.iterdir():
                if not path.is_file():
                    continue

                stat = path.stat()
                signature.append(
                    (
                        path.name.lower(),
                        int(stat.st_mtime_ns),
                        int(stat.st_size),
                    )
                )
        except OSError:
            return ()

        return tuple(sorted(signature))

    @classmethod
    def _canonical_key(cls, value: str) -> str:
        return cls._normalize(value).replace(" ", "_")

    @staticmethod
    def _compact(value: str) -> str:
        return re.sub(r"[^a-z0-9]+", "", str(value or "").lower())

    @staticmethod
    def _normalize(value: str) -> str:
        normalized = unicodedata.normalize(
            "NFKD",
            str(value or ""),
        )
        normalized = "".join(
            char
            for char in normalized
            if not unicodedata.combining(char)
        )
        normalized = normalized.lower().replace("_", " ")
        normalized = re.sub(r"[^a-z0-9]+", " ", normalized)
        return re.sub(r"\s+", " ", normalized).strip()

    @staticmethod
    def _display_name(value: str) -> str:
        return value.replace("_", " ").title()
