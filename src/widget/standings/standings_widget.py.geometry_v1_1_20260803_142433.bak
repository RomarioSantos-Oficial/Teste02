                incidents=1,
                gap_text="LEADER",
                interval_text="-",
                best_lap_text="3:24.810",
                last_lap_text="3:25.220",
                is_player=True,
                online_matched=True,
            ),
            StandingViewRow(
                position=2,
                class_position=2,
                position_change=-1,
                car_number="83",
                nationality="FR",
                badge="Staff",
                driver_name="Driver Online",
                team_name="Example Team",
                vehicle_class="HYPERCAR",
                driver_rank="Platinum 1",
                driver_rank_progress=12,
                safety_rank="Gold 1",
                estimated_driver_rank_gain=-1,
                incidents=0,
